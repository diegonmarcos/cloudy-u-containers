{
  "name": "chat-mattermost",
  "taxonomy": {"group": "Cloud Apps", "category": "Inboxes"},
  "description": "Mattermost team chat (TE 11.x ESR) with ntfy bridge and C3 command bot",
  "port": 8065,
  "dns": "mattermost.mesh.diegonmarcos.com",
  "dns_aliases": ["chat-mattermost.mesh.diegonmarcos.com", "chat.mesh.diegonmarcos.com"],
  "timezone": "America/Chicago",
  "c3": {
    "api_url": "http://c3-infra-api:8081",
    "port": 8887
  },
  "agents": {
    "llm_url": "http://localhost:3117",
    "llm_model": "claude-sonnet-4-6"
  },
  "sidebar_categories": {
    "ntfy": "NTFY",
    "agents": "AGENTS",
    "default_channels": "Projects"
  },
  "ports": {
    "app": 8065,
    "db": 5435
  },
  "category": "app",
  "build": {
    "include_cloud_data": "true",
    "headers_enforced": true
  },
  "domain": "chat.diegonmarcos.com",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/chat-mattermost",
    "compose_flags": "--build"
  },
  "compose": {
    "pre_hook": "assets/compose-pre-hook.sh"
  },
  "proxy": {
    "primary": {
      "domain": "chat.diegonmarcos.com",
      "auth": "two_factor",
      "bypass_paths": [
        "/api/v4/*"
      ]
    }
  },
  "health": {
    "path": "/api/v4/system/ping"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "backup": {
    "enabled": true,
    "volumes": [
      "mattermost_data",
      "mattermost_postgres"
    ]
  },
  "containers": {
    "app": {
      "container_name": "mattermost",
      "image": "ghcr.io/diegonmarcos/chat-mattermost-binaries:latest",
      "port": 8065,
      "port_env": "MM_SERVICESETTINGS_LISTENADDRESS",
      "dns": "mattermost.mesh.diegonmarcos.com",
      "public": true,
      "proxy": {
        "domain": "chat.diegonmarcos.com",
        "auth": "two_factor"
      },
      "healthcheck": "/api/v4/system/ping",
      "monitoring": {
        "tls_check": true
      },
      "volumes": [
        "./data/mattermost/config:/mattermost/config",
        "./data/mattermost/data:/mattermost/data",
        "./data/mattermost/logs:/mattermost/logs"
      ],
      "env_file": true,
      "depends_on": [
        "db"
      ],
      "resources": null,
      "read_only": false,
      "port_format": "colon",
      "protocol": "http"
    },
    "db": {
      "container_name": "mattermost-postgres",
      "taxonomy": {"group": "Infra Apps", "category": "Ops-dBs-cloud"},
      "image": "postgres:16-alpine",
      "port": 5435,
      "port_env": "PGPORT",
      "dns": "mattermost-postgres.mesh.diegonmarcos.com",
      "public": false,
      "healthcheck": "pg_isready -U mattermost -d mattermost",
      "volumes": [
        "./data/postgres:/var/lib/postgresql/data"
      ],
      "env_file": true,
      "resources": null,
      "read_only": false,
      "db_user": "mattermost",
      "db_name": "mattermost",
      "protocol": "tcp",
      "db_engine": "postgres"
    },
    "bots": {
      "container_name": "mattermost-bots",
      "image": "python:3.12-slim",
      "port": null,
      "port_env": null,
      "dns": "mattermost-bots.mesh.diegonmarcos.com",
      "public": false,
      "healthcheck": null,
      "volumes": [
        "./ntfy-bridge.py:/app/ntfy-bridge.py:ro",
        "./requirements-bridge.txt:/app/requirements.txt:ro"
      ],
      "env_file": true,
      "depends_on": [
        "app"
      ],
      "resources": null,
      "read_only": false
    }
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "chat-mattermost",
    "dockerfile": "Dockerfile",
    "arch": "arm64",
    "build_args": {
      "MM_PACKAGE": "https://releases.mattermost.com/11.8.0-rc5/mattermost-team-11.8.0-rc5-linux-arm64.tar.gz"
    },
    "_plugin_note": "Plugin list moved to src/code/arm64/plugins.json (data-driven, FIRE RULE 4). Add plugins by editing that file — no build.json or Dockerfile changes required. Auto-enable per plugin: env vars in compose.nix."
  },
  "api": {
    "type": "custom-rest",
    "base_path": "/api/v4",
    "display_name": "Mattermost",
    "description": "Open-source team chat platform with REST API.",
    "auth": "bearer"
  }
}
