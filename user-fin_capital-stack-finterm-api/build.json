{
  "name": "capital-stack-finterm-api",
  "taxonomy": {
    "group": "Project Apps",
    "category": "Finance"
  },
  "description": "Fincept Terminal backend (capital-stack-finterminal-api) \u2014 REST + WebSocket over DataHub, 35 data connectors, 7 analytics, 17 brokers, 6 investor personas, MCP tools",
  "dns": "capital-stack-finterm-api.mesh.diegonmarcos.com",
  "ports": {
    "app": 8340
  },
  "category": "fin",
  "domain": "api.diegonmarcos.com/capital-stack-finterminal-api",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/capital-stack-finterm-api",
    "compose_flags": "--build"
  },
  "compose": {
    "custom": false
  },
  "proxy": {
    "primary": {
      "type": "path",
      "parent_domain": "api.diegonmarcos.com",
      "base_path": "/capital-stack-finterm-api",
      "auth": "two_factor",
      "paths": {
        "/health": {
          "auth": "public"
        }
      }
    }
  },
  "health": {
    "path": "/capital-stack-finterminal-api/health"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "backup": {
    "enabled": false
  },
  "containers": {
    "app": {
      "container_name": "capital-stack-finterm-api",
      "image": "ghcr.io/diegonmarcos/capital-stack-finterm-api:latest",
      "port": 8340,
      "port_env": "FIN_API_PORT",
      "dns": "capital-stack-finterm-api.mesh.diegonmarcos.com",
      "public": true,
      "proxy": {
        "type": "path",
        "parent_domain": "api.diegonmarcos.com",
        "base_path": "/capital-stack-finterm-api",
        "auth": "two_factor"
      },
      "healthcheck": "/health",
      "monitoring": {
        "tls_check": true
      },
      "volumes": [
        "finterm_data:/data"
      ],
      "env_file": false,
      "resources": {
        "reservations": {
          "memory": "128M"
        }
      },
      "read_only": false,
      "protocol": "http"
    }
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "capital-stack-finterm-api",
    "dockerfile": "Dockerfile",
    "arch": "arm64",
    "native_build": {
      "cmd": "cargo build --release --bin fin-api",
      "binary": "target/release/fin-api",
      "builder_image": "rust:1-bookworm",
      "base_image": "debian:bookworm-slim",
      "apt": "ca-certificates libssl3 curl",
      "app_dir": "code"
    }
  },
  "build": {
    "headers_enforced": true
  },
  "api": {
    "type": "custom-rest",
    "base_path": "/capital-stack-finterm-api",
    "display_name": "Fincept Terminal (Rust)",
    "description": "Bloomberg-class financial intelligence platform with 35 data connectors, 7 analytics modules, 17 brokers, and 6 investor personas.",
    "auth": "bearer"
  },
  "legacy_aliases": {
    "names": [
      "capital-stack-finterminal-api"
    ],
    "dns_aliases": [
      "capital-stack-finterminal-api.mesh.diegonmarcos.com"
    ],
    "base_paths": [
      "/capital-stack-finterminal-api"
    ],
    "_doc": "API rebrand #1450: the old names stay served for one release (DNS alias, Caddy path rewrite from _rebrand-1450/caddy-legacy-redirects.caddy, old image tag). Remove after the alias release."
  },
  "dns_aliases": [
    "capital-stack-finterminal-api.mesh.diegonmarcos.com"
  ]
}
