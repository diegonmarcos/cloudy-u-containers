{
  "name": "cloudy-c3-api",
  "taxonomy": {
    "group": "Infra Apps",
    "category": "Ops-API-MCP"
  },
  "description": "C3 REST API \u2014 Cloud Control Center Fastify API",
  "dns": "cloudy-c3-api.mesh.diegonmarcos.com",
  "ports": {
    "app": 8081
  },
  "category": "sec",
  "domain": "api.diegonmarcos.com/c3-infra-api",
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "cloudy-c3-api",
    "dockerfile": "Dockerfile",
    "arch": "arm64",
    "native_build": {
      "type": "image-wrapper",
      "cmd": "npm ci --omit=dev",
      "entrypoint": "./entrypoint.sh",
      "base_image": "node:22-bookworm-slim",
      "apt": "ca-certificates openssh-client iputils-ping curl git python3 build-essential dnsutils openssl netcat-openbsd",
      "app_dir": "code",
      "user": "root"
    }
  },
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/cloudy-c3-api",
    "compose_flags": "--build"
  },
  "build": {
    "include_cloud_data": "true",
    "headers_enforced": true
  },
  "secrets": {
    "escape_dollars": "true"
  },
  "proxy": {
    "primary": {
      "auth": "two_factor",
      "type": "path",
      "parent_domain": "api.diegonmarcos.com",
      "base_path": "/cloudy-c3-api",
      "public_paths": [
        "/c3-infra-api/docs/json",
        "/c3-infra-api/public/logs",
        "/c3-infra-api/public/events/*"
      ]
    }
  },
  "health": {
    "path": "/c3-infra-api/health"
  },
  "tests": {
    "drift-multi-container": {
      "cmd": "node test-drift-multi-container.ts",
      "cwd": "src"
    },
    "jev-alert-priority": {
      "cmd": "node test-jev-alert-priority.ts",
      "cwd": "src"
    },
    "app-logs": {
      "cmd": "node test-app-logs.ts",
      "cwd": "src"
    },
    "configs-sync": {
      "cmd": "node test-configs-sync.ts",
      "cwd": "src"
    },
    "ai-usage": {
      "cmd": "node test-ai-usage.ts",
      "cwd": "src"
    },
    "ai-tokens": {
      "cmd": "node test-ai-tokens.ts",
      "cwd": "src"
    },
    "hierarchy": {
      "cmd": "node test-hierarchy.ts",
      "cwd": "src"
    }
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "containers": {
    "app": {
      "container_name": "cloudy-c3-api",
      "image": "ghcr.io/diegonmarcos/cloudy-c3-api:latest",
      "port": 8081,
      "port_env": "PORT",
      "dns": "cloudy-c3-api.mesh.diegonmarcos.com",
      "public": true,
      "proxy": {
        "type": "path",
        "parent_domain": "api.diegonmarcos.com",
        "base_path": "/cloudy-c3-api",
        "auth": "two_factor"
      },
      "healthcheck": "/health",
      "monitoring": {
        "tls_check": true,
        "dns_check": true,
        "endpoint_check": true
      },
      "volumes": [
        "/opt/ssh-keys/c3-infra-api:/root/.ssh:ro",
        "/nix/store:/nix/store:ro",
        "/home/ubuntu/.nix-profile/bin:/usr/local/nix-bin:ro",
        "~/.config/gcloud:/root/.config/gcloud",
        "octocode_repos:/root/git"
      ],
      "env_file": true,
      "depends_on": [],
      "resources": null,
      "read_only": false,
      "protocol": "http"
    }
  },
  "api": {
    "type": "openapi",
    "spec_path": "/docs/json",
    "base_path": "/cloudy-c3-api",
    "endpoint_count": 100,
    "display_name": "C3 Cloud Control Center API",
    "description": "REST API for cloud infrastructure operations, lifecycle control, and observability across inventory, operations, security, and FinOps.",
    "auth": "bearer"
  },
  "ssh": {
    "uid": 0,
    "ssh_dir": "/root/.ssh",
    "keys": [
      "vault_id_rsa",
      "vault_id_rsa.pub",
      "google_compute_engine",
      "google_compute_engine.pub"
    ]
  },
  "legacy_aliases": {
    "names": [
      "c3-infra-api"
    ],
    "dns_aliases": [
      "c3-infra-api.mesh.diegonmarcos.com"
    ],
    "base_paths": [
      "/c3-infra-api"
    ],
    "_doc": "API rebrand #1450: the old names stay served for one release (DNS alias, Caddy path rewrite from _rebrand-1450/caddy-legacy-redirects.caddy, old image tag). Remove after the alias release."
  },
  "dns_aliases": [
    "c3-infra-api.mesh.diegonmarcos.com"
  ]
}
