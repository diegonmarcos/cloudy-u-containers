{
  "name": "dagu",
  "taxonomy": {"group": "Infra Apps", "category": "Ops-Observability"},
  "description": "Dagu - Lightweight DAG-based workflow scheduler",
  "dns": "dagu.mesh.diegonmarcos.com",
  "ports": {
    "app": 8070
  },
  "category": "tools",
  "build": {
    "include_cloud_data": "true",
    "headers_enforced": true
  },
  "domain": "workflows.diegonmarcos.com",
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "dagu",
    "dockerfile": "Dockerfile",
    "arch": "arm64"
  },
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/dagu",
    "excludes": [
      "data"
    ]
  },
  "compose": {
    "custom": true
  },
  "proxy": {
    "primary": {
      "domain": "workflows.diegonmarcos.com",
      "auth": "two_factor"
    }
  },
  "health": {
    "path": "/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "containers": {
    "app": {
      "container_name": "dagu",
      "image": "ghcr.io/diegonmarcos/dagu-binaries:latest",
      "port": 8070,
      "port_env": "DAGU_PORT",
      "dns": "dagu.mesh.diegonmarcos.com",
      "public": true,
      "proxy": {
        "domain": "workflows.diegonmarcos.com",
        "auth": "two_factor"
      },
      "healthcheck": "/",
      "monitoring": {
        "tls_check": true,
        "dns_check": true,
        "endpoint_check": true
      },
      "volumes": [
        "./data:/var/lib/dagu/data",
        "./dags:/var/lib/dagu/dags",
        "./base.yaml:/var/lib/dagu/base.yaml:ro",
        "./fetch-token.sh:/var/lib/dagu/fetch-token.sh:ro",
        "/opt/ssh-keys/dagu:/home/dagu/.ssh:ro"
      ],
      "env_file": true,
      "depends_on": [],
      "resources": {},
      "read_only": false,
      "protocol": "http",
      "embedded_dbs": [
        {
          "engine": "sqlite",
          "path": "/var/lib/dagu/dagu.db"
        }
      ]
    }
  },
  "api": {
    "type": "custom-rest",
    "base_path": "/api/v1",
    "display_name": "Dagu Workflow Scheduler",
    "description": "Lightweight DAG-based workflow scheduler for orchestrating cloud infrastructure automation.",
    "auth": "none"
  },
  "ssh": {
    "uid": 0,
    "ssh_dir": "/root/.ssh",
    "keys": [
      "vault_id_rsa",
      "vault_id_rsa.pub",
      "google_compute_engine",
      "google_compute_engine.pub"
    ]
  },
  "tests": {
    "health_mail-reconcile": {
      "cmd": "python3 src/dags/test_health_mail-reconcile.py"
    },
    "health_mail-ingest": {
      "cmd": "python3 src/dags/test_health_mail-ingest.py"
    },
    "dag-keys": {
      "cmd": "python3 src/dags/test_dag-keys.py"
    },
    "jev-call-sites": {
      "cmd": "python3 src/dags/test_jev-call-sites.py"
    }
  }
}
