{
  "name": "cloudy-ai-api",
  "taxonomy": {
    "group": "Infra Apps",
    "category": "Net-Routing & Security"
  },
  "description": "AI gateway: /ai/{tokens,embeddings,agents,claude,memory} -> separate backend containers (cloudy-ai-*-api); legacy /<old-name>/ paths kept for one release.",
  "dns": "cloudy-ai-api.mesh.diegonmarcos.com",
  "ports": {
    "app": 4185
  },
  "category": "sec",
  "timezone": "Europe/Madrid",
  "build": {
    "include_cloud_data": "true",
    "headers_enforced": true
  },
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/cloudy-ai-api",
    "compose_flags": "--build"
  },
  "health": {
    "path": "/health"
  },
  "monitoring": {
    "tls_check": false,
    "dns_check": true,
    "endpoint_check": true
  },
  "docker": {
    "image": "cloudy-ai-api",
    "dockerfile": "Dockerfile",
    "registry": "ghcr.io/diegonmarcos",
    "arch": "arm64",
    "native_build": {
      "type": "image-wrapper",
      "cmd": "true",
      "entrypoint": "node index.ts",
      "base_image": "node:22-slim",
      "app_dir": "code"
    }
  },
  "containers": {
    "app": {
      "container_name": "cloudy-ai-api",
      "image": "ghcr.io/diegonmarcos/tokens-api-binaries:latest",
      "port": 4185,
      "port_env": null,
      "dns": "cloudy-ai-api.mesh.diegonmarcos.com",
      "public": true,
      "healthcheck": "/health",
      "monitoring": {
        "tls_check": false,
        "dns_check": true,
        "endpoint_check": true
      },
      "volumes": [
        "tokens_api_data:/data"
      ],
      "env_file": true,
      "depends_on": [],
      "resources": null,
      "read_only": false,
      "protocol": "http",
      "proxy": {
        "streaming": true,
        "type": "path",
        "parent_domain": "api.diegonmarcos.com",
        "base_path": "/ai"
      }
    }
  },
  "resources": {
    "mem_reservation": "16M",
    "mem_limit": "128M"
  },
  "tests": {
    "unit": {
      "cmd": "python3 -m pip install -q flask==3.0.0 'PyJWT[crypto]==2.9.0' cryptography==43.0.3 pytest && python3 -m pytest -q -p no:cacheprovider test",
      "cwd": "src"
    }
  },
  "api": {
    "type": "custom-rest",
    "base_path": "/",
    "endpoint_count": 8,
    "display_name": "Fleet Token Engine",
    "description": "Owner-only token manager (list, reveal, generate, import, revoke, audit) and the mesh-only /v1/verify that introspect-proxy calls.",
    "auth": "bearer"
  },
  "_draft": "#1450 pending owner deploy. Backends: tokens 4184, embeddings 7997, agents 3217, claude 3117, memory 3108 (ROUTES env overrides)."
}
