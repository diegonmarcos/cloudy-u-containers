{
  "name": "cloudy-ai-api",
  "taxonomy": {
    "group": "Infra Apps",
    "category": "Net-Routing & Security"
  },
  "description": "AI gateway: /ai/{tokens,embeddings,agents,claude,memory} -> separate backend containers (cloudy-ai-*-api); legacy /<old-name>/ paths kept for one release.",
  "dns": "cloudy-ai-api.mesh.diegonmarcos.com",
  "ports": {
    "app": 4185
  },
  "category": "sec",
  "timezone": "Europe/Madrid",
  "build": {
    "include_cloud_data": "true",
    "headers_enforced": true
  },
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/cloudy-ai-api",
    "compose_flags": "--build"
  },
  "health": {
    "path": "/health"
  },
  "monitoring": {
    "tls_check": false,
    "dns_check": true,
    "endpoint_check": true
  },
  "docker": {
    "image": "cloudy-ai-api",
    "dockerfile": "Dockerfile",
    "registry": "ghcr.io/diegonmarcos",
    "arch": "arm64",
    "native_build": {
      "type": "image-wrapper",
      "cmd": "true",
      "entrypoint": "node index.ts",
      "base_image": "node:22-slim",
      "app_dir": "code"
    }
  },
  "containers": {
    "app": {
      "container_name": "cloudy-ai-api",
      "image": "ghcr.io/diegonmarcos/cloudy-ai-api-binaries:latest",
      "port": 4185,
      "port_env": null,
      "dns": "cloudy-ai-api.mesh.diegonmarcos.com",
      "public": true,
      "healthcheck": "/health",
      "monitoring": {
        "tls_check": false,
        "dns_check": true,
        "endpoint_check": true
      },
      "volumes": [],
      "env_file": false,
      "depends_on": [],
      "resources": null,
      "read_only": false,
      "protocol": "http",
      "proxy": {
        "type": "path",
        "parent_domain": "api.diegonmarcos.com",
        "base_path": "/ai",
        "auth": "two_factor"
      }
    }
  },
  "resources": {
    "mem_reservation": "16M",
    "mem_limit": "128M"
  },
  "tests": {
    "unit": {
      "cmd": "node --test gateway.test.ts",
      "cwd": "src/code"
    }
  },
  "api": {
    "type": "custom-rest",
    "base_path": "/ai",
    "endpoint_count": 6,
    "display_name": "Cloudy AI gateway",
    "description": "One public prefix /ai/{tokens,embeddings,agents,claude,memory} in front of the five AI backend containers; legacy /<old-name>/ paths kept for one release; GET /health.",
    "auth": "bearer"
  },
  "_gateway": "Public route: api.diegonmarcos.com/ai and c3-pvt.diegonmarcos.com/ai, bearer-gated at the hub Caddy; backends are bound on the WireGuard IP (ROUTES env in compose.nix).",
  "proxy": {
    "primary": {
      "type": "path",
      "parent_domain": "api.diegonmarcos.com",
      "base_path": "/ai",
      "auth": "two_factor",
      "wg_only": true
    },
    "app_hub": false
  }
}
