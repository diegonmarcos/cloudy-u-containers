{
	admin off
	auto_https off
}
:3000 {
	handle /healthz {
		respond "ok" 200
	}
	@authed header Authorization "Bearer {env.STEEL_API_KEY}"
	handle @authed {
		reverse_proxy steel-browser:3000
	}
	handle {
		respond "unauthorized — steel-browser is owner-only; present a valid bearer" 401
	}
}
