# Type A — service-shipped Dockerfile, arch=amd64
# Source: infra-sec_caddy-public/src/code/Dockerfile
FROM caddy:2-builder AS builder
# Cache-bust 2026-06-19 — xcaddy resolves the plugins; the comment forces
# RUN-layer invalidation if a stale layer cache ever drops a plugin.
RUN xcaddy build \
    --with github.com/mholt/caddy-l4 \
    --with github.com/mholt/caddy-ratelimit \
    --with github.com/caddy-dns/cloudflare \
    --with github.com/porech/caddy-maxmind-geolocation@v1.0.3

# Geo-fence country database (#1102): baked at BUILD time, checksum pinned; nothing is
# downloaded at runtime. URL and SHA-256 must equal _shared/geo-fence.json db.* (guard:
# _shared/test/geo-fence-guard.sh). IP Geolocation by DB-IP (db-ip.com), CC BY 4.0.
ARG GEOIP_URL=https://download.db-ip.com/free/dbip-country-lite-2026-11.mmdb.gz
ARG GEOIP_SHA256=75fe430010f6d38a8c4331c202bf0df6ce3221a6e6d823b9e5a6d951e4cf9758
RUN wget -q -O /tmp/country.mmdb.gz "$GEOIP_URL" \
 && echo "$GEOIP_SHA256  /tmp/country.mmdb.gz" | sha256sum -c - \
 && mkdir -p /out/GeoIP && gunzip -c /tmp/country.mmdb.gz > /out/GeoIP/country.mmdb \
 && test -s /out/GeoIP/country.mmdb

FROM caddy:2
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
COPY --from=builder /out/GeoIP/country.mmdb /usr/share/GeoIP/country.mmdb

# Self-contained: only COPYs the Dockerfile itself, so the build context is
# just dist/code/<arch>/ (no nativeBuild.extraFiles needed).
COPY Dockerfile /opt/cloud-builder/Dockerfile
LABEL org.opencontainers.image.source="https://github.com/diegonmarcos/cloud-infra"
LABEL org.opencontainers.image.dockerfile-path="a_solutions/infra-sec_caddy-public/src/code/Dockerfile"

