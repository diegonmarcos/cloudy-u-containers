{
  "name": "capital-stack-news-gdelt-api",
  "taxonomy": {
    "group": "Cloud Apps",
    "category": "Inboxes"
  },
  "description": "GDELT News Aggregator \u2014 Fastify API with SQLite cache",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/capital-stack-news-gdelt-api",
    "compose_flags": "--build"
  },
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "capital-stack-news-gdelt-api",
    "arch": "arm64",
    "native_build": {
      "type": "image-wrapper",
      "cmd": "npm ci --omit=dev",
      "entrypoint": "node --experimental-strip-types server.ts",
      "base_image": "node:22-bookworm-slim",
      "apt": "curl ca-certificates python3 build-essential",
      "app_dir": "./code"
    }
  },
  "ports": {
    "app": 3019
  },
  "timezone": "Europe/Paris",
  "category": "tools",
  "health": {
    "path": "/health"
  },
  "containers": {
    "app": {
      "container_name": "capital-stack-news-gdelt-api",
      "image": "ghcr.io/diegonmarcos/capital-stack-news-gdelt-api:latest",
      "port": 3019,
      "protocol": "http",
      "port_env": "PORT"
    }
  },
  "build": {
    "headers_enforced": true
  },
  "legacy_aliases": {
    "names": [
      "news-gdelt"
    ],
    "dns_aliases": [],
    "base_paths": [],
    "_doc": "API rebrand #1450: the old names stay served for one release (DNS alias, Caddy path rewrite from _rebrand-1450/caddy-legacy-redirects.caddy, old image tag). Remove after the alias release."
  },
  "dns_aliases": []
}
