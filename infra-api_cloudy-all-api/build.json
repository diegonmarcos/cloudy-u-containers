{
  "name": "cloudy-all-api",
  "taxonomy": {
    "group": "Infra Apps",
    "category": "Ops-API-MCP"
  },
  "enabled": true,
  "build": {
    "include_cloud_data": "true",
    "headers_enforced": true
  },
  "description": "C3 Services REST API \u2014 service API gateway Fastify API",
  "dns": "cloudy-all-api.mesh.diegonmarcos.com",
  "ports": {
    "app": 8082
  },
  "category": "obs",
  "domain": "api.diegonmarcos.com/c3-services-api",
  "docker": {
    "registry": "ghcr.io/diegonmarcos",
    "image": "cloudy-all-api",
    "dockerfile": "Dockerfile",
    "arch": "arm64",
    "native_build": {
      "type": "image-wrapper",
      "cmd": "npm ci --omit=dev",
      "entrypoint": "./entrypoint.sh",
      "base_image": "node:22-bookworm-slim",
      "apt": "ca-certificates curl",
      "app_dir": "code"
    }
  },
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/cloudy-all-api"
  },
  "proxy": {
    "primary": {
      "type": "path",
      "parent_domain": "api.diegonmarcos.com",
      "base_path": "/cloudy-all-api",
      "auth": "two_factor",
      "paths": {
        "/docs/json": {
          "auth": "public"
        }
      }
    }
  },
  "health": {
    "path": "/c3-services-api/health"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "containers": {
    "app": {
      "container_name": "cloudy-all-api",
      "image": "ghcr.io/diegonmarcos/cloudy-all-api:latest",
      "port": 8082,
      "port_env": "PORT",
      "dns": "cloudy-all-api.mesh.diegonmarcos.com",
      "public": true,
      "proxy": {
        "type": "path",
        "parent_domain": "api.diegonmarcos.com",
        "base_path": "/cloudy-all-api",
        "auth": "two_factor"
      },
      "healthcheck": "/health",
      "monitoring": {
        "tls_check": true,
        "dns_check": true,
        "endpoint_check": true
      },
      "volumes": [],
      "env_file": true,
      "depends_on": [],
      "resources": null,
      "read_only": false,
      "protocol": "http"
    }
  },
  "api": {
    "type": "openapi",
    "spec_path": "/docs/json",
    "base_path": "/cloudy-all-api",
    "endpoint_count": 25,
    "display_name": "C3 Services API Gateway",
    "description": "Unified service API gateway that proxies and wraps OpenAPI services and custom REST/protocol endpoints.",
    "auth": "bearer"
  },
  "legacy_aliases": {
    "names": [
      "c3-services-api"
    ],
    "dns_aliases": [
      "c3-services-api.mesh.diegonmarcos.com"
    ],
    "base_paths": [
      "/c3-services-api"
    ],
    "_doc": "API rebrand #1450: the old names stay served for one release (DNS alias, Caddy path rewrite from _rebrand-1450/caddy-legacy-redirects.caddy, old image tag). Remove after the alias release."
  },
  "dns_aliases": [
    "c3-services-api.mesh.diegonmarcos.com"
  ]
}
